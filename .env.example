# LigaLokal — environment variables.
# Copy to .env.local for development; set the same names in your host's panel for production.
# NEVER commit real values. This file only documents names and shapes.

# ── Database (required) ────────────────────────────────────────────────────────
# MariaDB / MySQL. URL-encode special characters in the password.
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/ligalokal
# Connections per process; keep small on shared hosting.
# DATABASE_POOL_SIZE=5

# ── Auth.js (required in production) ───────────────────────────────────────────
# Signs the session cookie. Random, at least 32 characters:  openssl rand -base64 48
# The server refuses to start in production if this is missing, short or a placeholder.
# Rotating it signs everyone out.
AUTH_SECRET=
# Public URL of the site. In production it must be https:// — it pins the host Auth.js trusts.
AUTH_URL=http://localhost:3000
# Only for a proxy you control when AUTH_URL is not set. Otherwise leave unset.
# AUTH_TRUST_HOST=true

# ── Reverse proxy / rate limiting (set in production) ──────────────────────────
# How many reverse proxies sit in front of Node and append to X-Forwarded-For
# (1 = nginx/Hostinger, 2 = Cloudflare + nginx). Without it the login rate limiter counts per
# email only, because X-Forwarded-For cannot be trusted when Node is reachable directly.
# TRUSTED_PROXY_HOPS=1

# ── Cloudinary (optional — image upload signing) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Uploads may only target this folder (and its subfolders). Default: ligalokal
# CLOUDINARY_UPLOAD_FOLDER=ligalokal
# Only if you sign requests that use an upload preset; any other preset is refused.
# CLOUDINARY_UPLOAD_PRESET=

# ── Google Gemini (optional) ───────────────────────────────────────────────────
# Without it AI Scout falls back to the built-in data-driven analysis.
GEMINI_API_KEY=

# ── One-off scripts (run from a trusted shell, not part of the running app) ────
# First real account on a production database:
#   SUPER_ADMIN_EMAIL=... SUPER_ADMIN_PASSWORD=... npm run db:seed:super   (password: 12+ characters)
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
# Creates one login per business unit when running db:seed:finance:
# FINANCE_UNIT_PASSWORD=

# ── Development only — do NOT set these in production ──────────────────────────
# db:seed / db:reset refuse to run when NODE_ENV=production or the database is not local.
# ALLOW_DEMO_SEED=1   # create the shared-password dev accounts in a production-like environment
# ALLOW_DB_WIPE=1     # let db:seed / db:reset / db:copy-from-neon empty a non-local database
# NEON_DATABASE_URL=  # source for db:copy-from-neon (legacy)
# Throwaway databases for scripts/test-*.ts:
# INTELLIGENCE_TEST_DATABASE_URL=
# MATCH_TEST_DATABASE_URL=
# UPDATES_TEST_DATABASE_URL=
